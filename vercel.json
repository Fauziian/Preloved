    "APP_ENV": "production",
    "APP_DEBUG": "true",
    "APP_URL": "https://sherlypreloved.vercel.app",
    "APP_KEY": "base64:JyfuZYrHEifDf4t5bLp3IUARXDq5tze/8txbxBReTCo=",
    "VERCEL": "1",
    "DB_CONNECTION": "sqlite",
    "SESSION_DRIVER": "cookie",
    "SESSION_LIFETIME": "120",
    "CACHE_STORE": "file",
    "LOG_CHANNEL": "stderr",
    "LOG_LEVEL": "error"
  }
}
